# ============================================================
# GITROAST BACKEND — Environment Configuration Template
# ============================================================
# Copy this file to server/.env and populate the values for local development.
# On Render (Production), configure these under Dashboard -> Environment.

# ── Server & Runtime ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# MongoDB connection URI (e.g. MongoDB Atlas or local mongodb://localhost:27017/gitroast)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gitroast?retryWrites=true&w=majority

# ── CORS & Allowed Origins ────────────────────────────────────
# Comma-separated client URLs permitted to communicate with backend
CLIENT_URL=http://localhost:3000,https://gitroast.dev,https://www.gitroast.dev

# ── Authentication (JWT) ─────────────────────────────────────
# Random secret string for signing JSON Web Tokens
JWT_SECRET=replace_with_a_secure_random_hex_string
JWT_EXPIRES_IN=7d

# ── GitHub OAuth Application ─────────────────────────────────
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ── GitHub Personal Access Token (Optional Rate Limit Boost) ─
# Optional token to raise Render server unauthenticated quota from 60 to 5,000 req/hr
GITHUB_TOKEN=your_personal_access_token_here

# ── AI Engine (Google Gemini) ────────────────────────────────
# API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model ID (defaults to gemini-2.5-flash for lowest latency & streaming)
# Options: gemini-3.1-pro (latest Gemini 3.1 Pro reasoning), gemini-2.5-flash (recommended fast default), gemini-2.5-pro
# Note: gemini-3.1-pro automatically maps to official Google v1beta identifier 'gemini-3.1-pro-preview'
GEMINI_MODEL=gemini-3.1-pro

# ── Contact Us Email Forwarding (Resend REST API) ────────────
# Get free API key from https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_resend_api_key_here
OWNER_EMAIL=priyanshu.alt191@gmail.com
EMAIL_FROM=GitRoast <onboarding@resend.dev>

# ── Bot Protection (Google reCAPTCHA v3 or Enterprise) ───────
# Secret key from Google reCAPTCHA console: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
# Or for GCP Enterprise Assessments:
# RECAPTCHA_PROJECT_ID=your_gcp_project_id
# RECAPTCHA_API_KEY=your_recaptcha_api_key
# RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ── Payments (Razorpay Pro Membership) ───────────────────────
# Keys from Razorpay Dashboard: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Keep-Alive & Self-Ping (Render Free Tier) ────────────────
ENABLE_KEEP_ALIVE=true
RENDER_EXTERNAL_URL=https://gitroast-latest.onrender.com

# ── Distributed Cache & Rate Limiting (Upstash Serverless Redis) ─
# Free serverless Redis from https://upstash.com (10,000 commands/day free)
# Enables horizontal scaling across multiple container instances
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ── TypeSafe AI (System One / Jev Model) ─────────────────────
# Fast, calibrated structured judgments for support ticket triage & commit hygiene
# Get API key from TypeSafe Console: https://console.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here


