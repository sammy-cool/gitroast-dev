# ============================================================
# GITROAST FRONTEND — Environment Configuration Template
# ============================================================
# Copy this file to client/.env.local for local development.
# On Vercel (Production), configure these under Project Settings -> Environment Variables.

# ── Backend API URL ──────────────────────────────────────────
# Local dev: http://localhost:5000 | Production: https://gitroast-latest.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Site Canonical URL ───────────────────────────────────────
# Local dev: http://localhost:3000 | Production: https://gitroast.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google reCAPTCHA (Public Site Key) ───────────────────────
# Must match your domain (localhost for dev, gitroast.dev for prod)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ── Razorpay Public Key ID ───────────────────────────────────
# Used by client checkout modal (rzp_test_... for test, rzp_live_... for prod)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
